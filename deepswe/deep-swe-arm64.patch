diff --git a/tasks/eicrud-keyset-pagination-cursor/environment/Dockerfile b/tasks/eicrud-keyset-pagination-cursor/environment/Dockerfile
index 49bd318..09164ed 100644
--- a/tasks/eicrud-keyset-pagination-cursor/environment/Dockerfile
+++ b/tasks/eicrud-keyset-pagination-cursor/environment/Dockerfile
@@ -16,13 +16,14 @@ RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
     && rm -rf /var/lib/apt/lists/*
 
 
+# arm64 patch: MongoDB ships no Debian arm64 packages; use the Ubuntu jammy arm64 build (glibc-compatible with bookworm)
 RUN curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc \
         | gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg \
     && DISTRO_ID=$(. /etc/os-release && echo "$ID") \
     && DISTRO_CODENAME=$(lsb_release -cs) \
     && if [ "$DISTRO_ID" = "debian" ]; then COMPONENT="main"; else COMPONENT="multiverse"; fi \
-    && echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] \
-https://repo.mongodb.org/apt/${DISTRO_ID} ${DISTRO_CODENAME}/mongodb-org/7.0 ${COMPONENT}" \
+    && echo "deb [ arch=arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] \
+https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" \
         > /etc/apt/sources.list.d/mongodb-org-7.0.list \
     && apt-get update && apt-get install -y mongodb-org \
     && rm -rf /var/lib/apt/lists/*
@@ -99,4 +100,10 @@ RUN git checkout -- package.json package-lock.json \
 # Broken hook environments otherwise block the agent's (and oracle's) commits.
 RUN cd /app && git config core.hooksPath /dev/null
 
+# arm64/host patch: hosts whose Docker default soft nofile limit is 1024 make mongod drop connections
+# ("Too many open files") midway through the serial jest run; raise the soft limit to the hard limit at start.
+RUN mv /usr/bin/mongod /usr/bin/mongod.real \
+ && printf '#!/bin/sh\nulimit -n "$(ulimit -Hn)" 2>/dev/null\nexec /usr/bin/mongod.real "$@"\n' > /usr/bin/mongod \
+ && chmod +x /usr/bin/mongod
+
 CMD ["/bin/bash"]
